{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaia://schemas/formalization-validation/1.0.0",
  "title": "Gaia node and edge level formalization validation report",
  "type": "object",
  "required": ["schema_name", "schema_version", "report_id", "artifact_under_test", "validator", "step", "summary", "checks", "findings"],
  "properties": {
    "schema_name": {"const": "gaia.formalization.validation"},
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "minLength": 1},
    "artifact_under_test": {
      "type": "object",
      "required": ["kind", "content_hash"],
      "properties": {
        "kind": {"enum": ["formalization.snapshot", "formalization"]},
        "snapshot_id": {"type": "string", "minLength": 1},
        "revision_id": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "validator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "step": {"type": "integer", "minimum": 1, "maximum": 5},
    "phase": {"type": "string", "minLength": 1},
    "summary": {
      "type": "object",
      "required": ["status", "errors", "warnings", "findings"],
      "properties": {
        "status": {"enum": ["passed", "warning", "failed"]},
        "errors": {"type": "integer", "minimum": 0},
        "warnings": {"type": "integer", "minimum": 0},
        "findings": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "status", "checked_objects", "finding_ids"],
        "properties": {
          "rule": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "warning", "failed"]},
          "checked_objects": {"type": "integer", "minimum": 0},
          "finding_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["finding_id", "rule", "severity", "target", "message", "location", "suggested_action"],
        "properties": {
          "finding_id": {"type": "string", "minLength": 1},
          "rule": {"type": "string", "minLength": 1},
          "severity": {"enum": ["error", "warning"]},
          "target": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": {"enum": ["snapshot", "knowledge", "reasoning_unit", "operator", "source_anchor", "edge"]},
              "id": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "related_target": {"type": "object"},
          "edge": {"type": "object"},
          "message": {"type": "string", "minLength": 1},
          "location": {
            "type": "object",
            "required": ["json_pointer"],
            "properties": {"json_pointer": {"type": "string", "pattern": "^/"}},
            "additionalProperties": false
          },
          "suggested_action": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
