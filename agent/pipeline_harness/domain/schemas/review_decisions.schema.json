{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gaia://schemas/review-decisions/1.0.0",
  "title": "Hash-bound human review decisions",
  "type": "object",
  "required": ["schema_version", "formalization_artifact_id", "formalization_content_hash", "decisions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "formalization_artifact_id": {"type": "string", "minLength": 1},
    "formalization_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "decision", "reviewer", "reviewed_at", "rationale"],
        "properties": {
          "proposal_id": {"type": "string", "minLength": 1},
          "decision": {"enum": ["approved", "rejected"]},
          "reviewer": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
