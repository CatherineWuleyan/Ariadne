{
  "pipeline_id": "pipeline-merge-question",
  "version": "0.1.0",
  "view_adapter": "pipeline_merge_question.question_view:QuestionViewAdapter",
  "stages": [
    {
      "name": "step0_select_scope",
      "plugin": "pipeline_merge_question.step0:Step0SelectScopePlugin",
      "options": {
        "mode": "bootstrap",
        "scope": {
          "domain": "research-domain",
          "selection": [
            "papers:paper_a",
            "papers:paper_b"
          ]
        }
      }
    },
    {
      "name": "step1_freeze_inputs",
      "plugin": "pipeline_merge_question.step1:Step1FreezeInputsPlugin",
      "options": {}
    },
    {
      "name": "step2_retrieve_domain_local",
      "plugin": "pipeline_merge_question.step2:Step2RetrieveDomainLocalPlugin",
      "options": {}
    },
    {
      "name": "step3_identify_structures",
      "plugin": "pipeline_merge_question.step3:Step3IdentifyStructuresPlugin",
      "options": {
        "summarize_conclusions": true,
        "allow_infer": true
      }
    },
    {
      "name": "step3b_align_domain_spine",
      "plugin": "pipeline_merge_question.step3b:Step3bAlignDomainSpinePlugin",
      "options": {}
    },
    {
      "name": "step4_formalize_integration",
      "plugin": "pipeline_merge_question.step4:Step4FormalizeIntegrationPlugin",
      "options": {}
    },
    {
      "name": "step5_compile_gaia_ir",
      "plugin": "pipeline_merge_question.step5:Step5CompileMergedGaiaIRPlugin",
      "options": {
        "compiler_plugin": "pipeline_harness.domain.compiler:Gaia05OfficialCompilerTool"
      }
    },
    {
      "name": "step6_question_answer_layer",
      "plugin": "pipeline_merge_question.step6_question_layer:Step6QuestionLayerPlugin",
      "options": {
        "question_zh": "研究问题",
        "question_en": "Research question",
        "domain": "research-domain",
        "max_roots": 5
      }
    }
  ]
}
